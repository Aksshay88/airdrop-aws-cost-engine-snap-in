# Your DevRev organization slug (the part after app.devrev.ai/ in your DevRev URL)
DEV_ORG=my-org

# Your email address
USER_EMAIL=my@email.com

# Environment
ENV=dev|qa|prod

# --- AWS Cost Engine (external system) ---
# Seeded by connector-planner. Copy this file to code/.env and fill in values;
# code/.env is gitignored. Placeholders only here — never commit a real token.

# Base URL of the engine's optional HTTP surface. Required: the engine is
# self-hosted, so there is no canonical host to default to.
COST_ENGINE_BASE_URL=http://127.0.0.1:8000

# The engine's own API token (its COST_AGENT_API_TOKEN), sent as
# `Authorization: Bearer <token>`. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# This is NOT an AWS credential. The engine resolves AWS access through the
# standard SDK chain and never accepts AWS keys as configuration.
COST_ENGINE_TOKEN=replace-with-the-engine-api-token

# External sync unit id. The engine has no "list accounts" endpoint: the sync
# unit comes from `POST /v1/preflight` -> identity.account_id. In fixture mode
# that field is null, so this value is the fallback. Required in that case —
# the extractor will not invent an account id.
COST_ENGINE_SYNC_UNIT_ID=aws-cost-engine-local

# DevRev product that findings attach to. DevRev requires
# `applies_to_part_id` on an issue and the engine has no product concept, so
# this must be configured. See plans/aws-cost-engine.md §10 Open #6.
COST_ENGINE_APPLIES_TO_PART_ID=
